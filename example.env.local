# Compose publishes the backend at port 5000; authentication routes use /api/v1/auth/*.
NEXT_PUBLIC_API_URL=http://localhost:5000/api/v1

# Must exactly match the dashboard's public URL in each environment.
NEXTAUTH_URL=http://localhost:3000

# Generate a unique, server-only value for every environment. Never commit it.
NEXTAUTH_SECRET=replace-with-a-unique-long-random-secret
